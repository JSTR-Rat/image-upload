# Copy to `.env.production` for `pnpm run build:production` / `pnpm run deploy:production`.
# `BETTER_AUTH_URL` stays in `wrangler.jsonc` → `env.production.vars`.
CLOUDFLARE_ENV=production

VITE_PUBLIC_IMAGE_CDN_ORIGIN=https://cdn.img.jstr.sh

# Generate `BETTER_AUTH_SECRET`: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
