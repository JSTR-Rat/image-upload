# Copy to `.env.staging` for `pnpm run build:staging` / `pnpm run deploy:staging`.
# `BETTER_AUTH_URL` stays in `wrangler.jsonc` → `env.staging.vars`.
CLOUDFLARE_ENV=staging

VITE_PUBLIC_IMAGE_CDN_ORIGIN=https://cdn.staging.img.jstr.sh

# Generate `BETTER_AUTH_SECRET`: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
