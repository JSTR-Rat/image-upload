{
  "name": "image-upload",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "auth:generate": "pnpm dlx auth@1.7.4 generate --output src/db/schema/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply image-upload-db-local --local",
    "db:migrate:staging": "wrangler d1 migrations apply image-upload-db-staging --remote -e staging",
    "db:migrate:production": "wrangler d1 migrations apply image-upload-db --remote -e production",
    "db:studio:local": "drizzle-kit studio --config drizzle.local.config.ts",
    "deploy:staging": "pnpm run build:staging && wrangler deploy",
    "deploy:production": "pnpm run build:production && wrangler deploy",
    "cf-typegen": "wrangler types",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@headlessui/react": "^2.2.10",
    "@silvia-odwyer/photon": "^0.3.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.3",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-start": "^1.167.65",
    "@tanstack/router-plugin": "^1.132.0",
    "@tanstack/zod-adapter": "^1.166.9",
    "better-auth": "^1.7.4",
    "better-sqlite3": "^12.6.2",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "image-size": "npm:image-size-next@2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.20.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "better-sqlite3",
      "workerd"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-67mh-4wv8-2f99"
      ]
    },
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "brace-expansion@5": "5.0.9",
      "js-yaml@4": "4.3.2",
      "undici": ">=7.29.0",
      "ws": ">=8.21.0",
      "postcss": ">=8.5.23",
      "nanoid@3": ">=3.3.18",
      "browserslist": ">=4.28.7",
      "shell-quote": ">=1.9.0",
      "launch-editor": ">=2.14.1",
      "@babel/core": ">=7.29.6 <8",
      "baseline-browser-mapping": ">=2.11.0",
      "sharp": ">=0.35.4"
    }
  }
}
